# Reflector (Rust) — configuration.
#
# Only PUBLIC_URL has no default. Everything else falls back to the vendored
# GitHub Issues document and the localthought/test-repo-1 target — the single
# platform reflected when PLATFORMS (below) is left unset.

# The origin this store's data is public on the web under. Every internal:/path
# subject — the minted ontology's classes and properties included — is served
# as <PUBLIC_URL>/path, so this is what makes the ontology's URLs resolvable.
PUBLIC_URL=https://my-ontologies.com

# The OpenAPI document the sync flow is derived from. Only read when PLATFORMS
# (below) is unset.
OPENAPI_DOCUMENT=spec/github/github-issues.openapi.yaml

# OpenAPI Overlays applied to it, in order. Only read when PLATFORMS is unset.
OPENAPI_OVERLAYS=spec/github/overlays/auth-overlay.yaml,spec/github/overlays/pagination-overlay.yaml,spec/github/overlays/crud-causality-overlay.yaml

# Credentials for the API. A GitHub personal-access or installation token with
# read access to the repository named below. GITHUB_TOKEN is accepted as an
# alias. Only read when PLATFORMS is unset.
API_TOKEN=

# Constants bound into the document's path and query parameters. This is what
# narrows the sync to ONE issue tracker rather than every tracker the token can
# reach. Only read when PLATFORMS is unset.
API_CONSTANTS=owner=localthought,repo=test-repo-1

# Sync more than one platform in a single run — a comma-separated list of
# platform names, each configured by its own <PLATFORM>_-prefixed variables
# instead of the unprefixed ones above (e.g. GOOGLE_CALENDAR_API_TOKEN). See
# README's "Reflecting more than one platform" section. Leave unset to just
# reflect `github` from the unprefixed variables above.
# PLATFORMS=github,google-calendar
# GITHUB_API_TOKEN=
# GOOGLE_CALENDAR_API_TOKEN=
# GOOGLE_CALENDAR_API_CONSTANTS=calendarId=primary

# Directory containing atomic.redb. Stop AtomicServer before sharing its store.
STORE_DIR=data/store
# macOS: export STORE_DIR="$HOME/Library/Application Support/atomic-data/store"

# Your AtomicServer agent subject; grants access to the imported drive and,
# if that agent already has a local resource, adds the drive to its
# saved-drive list so it shows up in the app.
# DRIVE_OWNER=did:ad:agent:YOUR_PUBLIC_KEY

# Interactive OAuth fallback for the github platform, used when its token is
# missing or GitHub no longer accepts it. Both must be set together (a GitHub
# OAuth App's client id and secret, https://docs.github.com/en/apps/oauth-apps)
# — otherwise this crate behaves exactly as it does with only a github token
# configured. GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are accepted as aliases.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# host:port the local OAuth callback web server binds to. Register
# http://<this>/callback as the OAuth App's "Authorization callback URL".
OAUTH_REDIRECT_ADDR=127.0.0.1:8901

# OAuth scope requested from GitHub during the authorization-code flow.
OAUTH_SCOPE=repo

# Log level. Loro's per-block INFO logging is quieted by default.
# RUST_LOG=info
