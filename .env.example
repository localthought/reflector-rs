# Reflector (Rust) — configuration.
#
# Only PUBLIC_URL has no default. Everything else falls back to the vendored
# GitHub Issues document and the localthought/test-repo-1 target.

# The origin this store's data is public on the web under. Every internal:/path
# subject — the minted ontology's classes and properties included — is served
# as <PUBLIC_URL>/path, so this is what makes the ontology's URLs resolvable.
PUBLIC_URL=https://my-ontologies.com

# The OpenAPI document the sync flow is derived from.
OPENAPI_DOCUMENT=spec/github-issues.openapi.yaml

# OpenAPI Overlays applied to it, in order.
OPENAPI_OVERLAYS=spec/overlays/github/auth-overlay.yaml,spec/overlays/github/pagination-overlay.yaml,spec/overlays/github/crud-causality-overlay.yaml

# Credentials for the API. A GitHub personal-access or installation token with
# read access to the repository named below. GITHUB_TOKEN is accepted as an alias.
API_TOKEN=

# Constants bound into the document's path and query parameters. This is what
# narrows the sync to ONE issue tracker rather than every tracker the token can
# reach.
API_CONSTANTS=owner=localthought,repo=test-repo-1

# Directory containing atomic.redb. Stop AtomicServer before sharing its store.
STORE_DIR=data/store
# macOS: export STORE_DIR="$HOME/Library/Application Support/atomic-data/store"

# Your AtomicServer agent subject; grants access to newly created drives only.
# DRIVE_OWNER=did:ad:agent:YOUR_PUBLIC_KEY

# Interactive OAuth fallback, used when API_TOKEN is missing or GitHub no
# longer accepts it. Both must be set together (a GitHub OAuth App's client
# id and secret, https://docs.github.com/en/apps/oauth-apps) — otherwise this
# crate behaves exactly as it does with only API_TOKEN configured. GITHUB_
# CLIENT_ID / GITHUB_CLIENT_SECRET are accepted as aliases.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# host:port the local OAuth callback web server binds to. Register
# http://<this>/callback as the OAuth App's "Authorization callback URL".
OAUTH_REDIRECT_ADDR=127.0.0.1:8901

# OAuth scope requested from GitHub during the authorization-code flow.
OAUTH_SCOPE=repo

# Log level. Loro's per-block INFO logging is quieted by default.
# RUST_LOG=info
